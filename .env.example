# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public HTTPS URL of the separately deployed server.ts API when the frontend is on GitHub Pages.
# Set the same value as the GitHub Actions repository variable VITE_GEMINI_API_BASE_URL.
# Never put GEMINI_API_KEY in a VITE_* variable; Vite exposes VITE_* values to the browser.
VITE_GEMINI_API_BASE_URL=""

# When the API is hosted on another origin, allow only the frontend origin.
CORS_ORIGIN="https://YOUR-USER.github.io/YOUR-REPOSITORY"

# Number of trusted reverse-proxy hops in front of Express (Cloud Run usually uses 1).
TRUST_PROXY_HOPS="1"

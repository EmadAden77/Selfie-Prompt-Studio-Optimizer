function CardRadio({ selected, onClick, title, activeColor = "emerald" }: {
  selected: boolean;
  onClick: () => void;
  title: string;
  activeColor?: string;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`p-2.5 rounded-xl text-xs text-right border transition ${
        selected
          ? `bg-${activeColor}-600 text-white border-${activeColor}-500 font-semibold shadow-sm`
          : "bg-zinc-800/60 hover:bg-zinc-800 text-zinc-300 border-transparent hover:border-zinc-700"
      }`}
    >
      {title}
    </button>
  );
}

function BadgeSelect({ selected, onClick, children }: {
  selected: boolean;
  onClick: () => void;
  children: React.ReactNode;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      className={`px-3 py-1.5 rounded-xl text-xs font-medium transition ${
        selected
          ? "bg-emerald-600 text-white shadow-sm"
          : "bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300"
      }`}
    >
      {children}
    </button>
  );
}

function MultiToggleGroup({ title, items, activeIds, onToggle, itemBg }: {
  title: string;
  items: Opt[];
  activeIds: string[];
  onToggle: (id: string) => void;
  itemBg: string;
}) {
  return (
    <div className="space-y-1.5">
      <label className="text-xs font-semibold text-zinc-300 block">{title}</label>
      <div className="flex flex-wrap gap-1.5">
        {items.map(item => {
          const on = activeIds.includes(item.id);
          return (
            <button
              key={item.id}
              type="button"
              onClick={() => onToggle(item.id)}
              className={`px-2.5 py-1.5 rounded-xl text-xs transition border ${
                on
                  ? "bg-emerald-600 text-white font-semibold border-emerald-500 shadow-sm"
                  : `${itemBg} border-transparent text-zinc-400 hover:text-zinc-200`
              }`}
            >
              {item.ar}
            </button>
          );
        })}
      </div>
    </div>
  );
}

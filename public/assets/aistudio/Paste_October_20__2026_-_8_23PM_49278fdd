const STORAGE_KEY = "selfie-prompt-studio-v9.5";

interface StoredState {
  locId?: number; carModelId?: string; carColorId?: string; clothId?: string;
  accessoryId?: string; poseId?: string; anatomicalExprId?: string; frameId?: string; aspectId?: string;
  phoneId?: string; angleId?: string; lightId?: string; beardId?: string; hairId?: string; heightCueId?: string;
  storylineId?: string; tintId?: string; opticalIds?: string[]; cabinIds?: string[]; skinNuanceIds?: string[];
  appUiIds?: string[]; gripMotionIds?: string[]; dashUiIds?: string[]; subsurfaceIds?: string[]; fabricIds?: string[];
  thermalIds?: string[]; clutterIds?: string[]; lang?: Lang; darkMode?: boolean; sessions?: SavedSession[];
}

function loadInitialState(): StoredState {
  try {
    const raw = typeof window !== "undefined" ? localStorage.getItem(STORAGE_KEY) : null;
    return raw ? JSON.parse(raw) : {};
  } catch {
    return {};
  }
}

function saveStored(s: StoredState) {
  try {
    if (typeof window !== "undefined") {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
    }
  } catch {}
}

